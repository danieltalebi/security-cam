{
  "camera": {
    "name": "backyard",
    "credential_prefix": "CAMERA_BACKYARD",
    "host": "backyard-camera.local"
  },
  "onvif": {
    "device_service": "http://{host}:8899/onvif/device_service"
  },
  "dvrip": {
    "host": "{host}",
    "port": 34567,
    "event_debounce_seconds": 3,
    "notification_cooldown_seconds": 40
  },
  "snapshot": {
    "url": "http://{host}/webcapture.jpg?command=snap&channel=0",
    "xmeye_query_auth": true,
    "review_dir": "events/review/backyard"
  },
  "confirmation": {
    "model": "yolov8n.pt",
    "confidence": 0.5,
    "video_fallback_seconds": 8,
    "video_sample_seconds": 0.8
  },
  "telegram": {
    "token_env": "TELEGRAM_BOT_TOKEN",
    "chat_id_env": "TELEGRAM_CHAT_ID"
  }
}
