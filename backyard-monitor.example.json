{
  "onvif": {
    "device_service": "http://BACKYARD_CAMERA_IP:8899/onvif/device_service",
    "username_env": "CAMERA_BACKYARD_ONVIF_USER",
    "password_env": "CAMERA_BACKYARD_ONVIF_PASSWORD"
  },
  "dvrip": {
    "host": "BACKYARD_CAMERA_IP",
    "port": 34567,
    "username_env": "CAMERA_BACKYARD_DVRIP_USER",
    "password_env": "CAMERA_BACKYARD_DVRIP_PASSWORD",
    "notification_cooldown_seconds": 40
  },
  "snapshot": {
    "url": "http://BACKYARD_CAMERA_IP/webcapture.jpg?command=snap&channel=0",
    "xmeye_query_auth": true,
    "review_dir": "events/review/backyard"
  },
  "telegram": {
    "token_env": "TELEGRAM_BOT_TOKEN",
    "chat_id_env": "TELEGRAM_CHAT_ID"
  }
}
