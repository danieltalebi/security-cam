{
  "outputs": {
    "mode": "mqtt"
  },
  "home_assistant": {
    "mqtt": {
      "host_env": "HA_MQTT_HOST",
      "port_env": "HA_MQTT_PORT",
      "username_env": "HA_MQTT_USER",
      "password_env": "HA_MQTT_PASSWORD",
      "topic_prefix": "security_cam",
      "discovery_prefix": "homeassistant",
      "qos": 1,
      "tls": false
    }
  },
  "health": {
    "camera_offline_alert_seconds": [300],
    "camera_offline_repeat_seconds": 21600,
    "internet_enabled": true,
    "internet_poll_seconds": 30,
    "internet_timeout_seconds": 5,
    "internet_failure_threshold": 2,
    "internet_outage_alert_seconds": 600,
    "router_offline_alert_seconds": 3600,
    "daily_summary_time": "18:00",
    "timezone": "America/Argentina/Buenos_Aires",
    "connectivity_state_file": ".connectivity-history.json"
  },
  "alarm_policy": {
    "state_file": ".security-cam-state.json",
    "automatic": {
      "timezone": "America/Argentina/Buenos_Aires",
      "day_start": "08:30",
      "night_start": "23:00",
      "away_debounce_seconds": 300
    },
    "incidents": {
      "close_after_seconds": 60,
      "notification_backoff_seconds": [0, 60, 180, 300, 600]
    }
  },
  "presence": {
    "enabled": false,
    "poll_interval_seconds": 30,
    "devices": [
      {
        "name": "iPhone",
        "macs": ["00:00:00:00:00:01"]
      },
      {
        "name": "iPhone 2",
        "macs": ["00:00:00:00:00:02"]
      }
    ],
    "sources": [
      {
        "type": "asuswrt",
        "name": "asus",
        "host": "192.168.50.1",
        "username_env": "ASUS_ROUTER_USER",
        "password_env": "ASUS_ROUTER_PASSWORD",
        "macs_from": "huawei",
        "discover_via": "huawei",
        "device_ouis": ["fc:34:97"]
      },
      {
        "type": "huawei",
        "name": "huawei",
        "host": "192.168.100.1",
        "username_env": "HUAWEI_ROUTER_USER",
        "password_env": "HUAWEI_ROUTER_PASSWORD",
        "macs": ["00:00:00:00:00:01", "00:00:00:00:00:02"]
      }
    ]
  },
  "cameras": [
    {
      "name": "garage",
      "mode": "property",
      "role": "exterior",
      "config": "smart-monitor.json"
    },
    {
      "name": "backyard",
      "mode": "presence",
      "role": "exterior",
      "config": "backyard-monitor.json"
    }
  ]
}
