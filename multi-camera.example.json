{
  "outputs": {
    "mode": "mqtt"
  },
  "home_assistant": {
    "mqtt": {
      "host_env": "HA_MQTT_HOST",
      "port_env": "HA_MQTT_PORT",
      "username_env": "HA_MQTT_USER",
      "password_env": "HA_MQTT_PASSWORD",
      "topic_prefix": "security_cam",
      "discovery_prefix": "homeassistant",
      "qos": 1,
      "tls": false
    }
  },
  "health": {
    "camera_offline_alert_seconds": [60, 300, 1800],
    "internet_enabled": true,
    "internet_poll_seconds": 30,
    "internet_timeout_seconds": 5,
    "internet_failure_threshold": 2
  },
  "presence": {
    "enabled": false,
    "poll_interval_seconds": 30,
    "devices": [
      {
        "name": "Daniel iPhone",
        "macs": ["00:00:00:00:00:01"]
      },
      {
        "name": "Second iPhone",
        "macs": ["00:00:00:00:00:02"]
      }
    ],
    "sources": [
      {
        "type": "asuswrt",
        "name": "asus",
        "host": "192.168.50.1",
        "username_env": "ASUS_ROUTER_USER",
        "password_env": "ASUS_ROUTER_PASSWORD",
        "macs_from": "huawei",
        "discover_via": "huawei",
        "device_ouis": ["fc:34:97"]
      },
      {
        "type": "huawei",
        "name": "huawei",
        "host": "192.168.100.1",
        "username_env": "HUAWEI_ROUTER_USER",
        "password_env": "HUAWEI_ROUTER_PASSWORD",
        "macs": ["00:00:00:00:00:01", "00:00:00:00:00:02"]
      }
    ]
  },
  "cameras": [
    {
      "name": "garage",
      "mode": "property",
      "config": "smart-monitor.json"
    },
    {
      "name": "backyard",
      "mode": "presence",
      "config": "backyard-monitor.json"
    }
  ]
}
